# Experimental symbolic field; not connected to real CK3 combat.
window = {
    name = "vvv_battlefield"
    layer = top
    size = { 760 500 }
    parentanchor = hcenter|vcenter
    movable = yes
    visible = "[And( GetPlayer.IsValid, GetVariableSystem.Exists('vvv_open_map') )]"
    using = Window_Background
    text_single = { position = { 30 20 } text = "vvv_panel_title" using = Font_Size_Large }
    text_single = { position = { 30 55 } text = "vvv_panel_subtitle" }
    button_standard = { position = { 623 20 } size = { 100 30 } text = "vvv_close" onclick = "[GetVariableSystem.Clear('vvv_open_map')]" }

    button_standard = { position = { 45 100 } size = { 195 52 } text = "vvv_enemy_left" enabled = no }
    text_single = { position = { 79 177 } text = "vvv_terrain_left" }
    button_standard = {
        position = { 45 225 } size = { 195 52 }
        text = "vvv_our_regiment"
        visible = "[GetScriptedGui('vvv_gui_is_left').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        onclick = "[GetScriptedGui('vvv_gui_left').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
    }
    button_standard = { position = { 280 100 } size = { 195 52 } text = "vvv_enemy_center" enabled = no }
    text_single = { position = { 314 177 } text = "vvv_terrain_center" }
    button_standard = {
        position = { 280 225 } size = { 195 52 }
        text = "vvv_our_regiment"
        visible = "[GetScriptedGui('vvv_gui_is_center').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        onclick = "[GetScriptedGui('vvv_gui_center').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
    }
    button_standard = { position = { 515 100 } size = { 195 52 } text = "vvv_enemy_right" enabled = no }
    text_single = { position = { 549 177 } text = "vvv_terrain_right" }
    button_standard = {
        position = { 515 225 } size = { 195 52 }
        text = "vvv_our_regiment"
        visible = "[GetScriptedGui('vvv_gui_is_right').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        onclick = "[GetScriptedGui('vvv_gui_right').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
    }
    button_standard = { position = { 45 300 } size = { 133 32 } text = "vvv_move_left" onclick = "[GetScriptedGui('vvv_gui_left').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
    button_standard = { position = { 184 300 } size = { 133 32 } text = "vvv_move_center" onclick = "[GetScriptedGui('vvv_gui_center').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
    button_standard = { position = { 323 300 } size = { 133 32 } text = "vvv_move_right" onclick = "[GetScriptedGui('vvv_gui_right').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
    button_standard = { position = { 462 300 } size = { 112 32 } text = "vvv_hold" onclick = "[GetScriptedGui('vvv_gui_hold').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
    button_standard = { position = { 580 300 } size = { 145 32 } text = "vvv_charge" onclick = "[GetScriptedGui('vvv_gui_charge').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
    text_single = { position = { 46 365 } text = "vvv_round_label" }
    text_single = { position = { 136 365 } text = "[GetPlayer.MakeScope.Var('vvv_round').GetValue|0]" }
    text_single = { position = { 215 365 } text = "vvv_morale_label" }
    text_single = { position = { 305 365 } text = "[GetPlayer.MakeScope.Var('vvv_morale').GetValue|0]" }
    text_single = { position = { 380 365 } text = "vvv_momentum_label" }
    text_single = { position = { 470 365 } text = "[GetPlayer.MakeScope.Var('vvv_momentum').GetValue|0]" }
    text_single = { position = { 570 365 } text = "vvv_risk_label" }
    text_single = { position = { 660 365 } text = "[GetPlayer.MakeScope.Var('vvv_risk').GetValue|0]" }
    button_standard = { position = { 45 420 } size = { 235 40 } text = "vvv_reset" onclick = "[GetScriptedGui('vvv_gui_reset').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
    button_standard = { position = { 492 420 } size = { 233 40 } text = "vvv_next" onclick = "[GetScriptedGui('vvv_gui_next').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
}
