# VVV 0.1.3: native 2D board. Text, selection and orders remain live GUI elements.
# Demo army strengths are deliberately independent of real CK3 combat.
window = {
    name = "vvv_battlefield"
    layer = top
    size = { 1060 672 }
    parentanchor = center
    movable = yes
    visible = "[And( GetPlayer.IsValid, GetVariableSystem.Exists('vvv_open_map') )]"
    using = Window_Background
    allow_outside = no

    text_single = { position = { 22 10 } size = { 180 34 } autoresize = no align = left|nobaseline fontsize = 24 text = "vvv_panel_title"  }
    text_single = { position = { 205 14 } size = { 650 30 } autoresize = no align = left|nobaseline fontsize = 15 text = "vvv_panel_subtitle"  }
    button_standard = { position = { 945 15 } size = { 93 30 } text = "vvv_close" onclick = "[GetVariableSystem.Clear('vvv_open_map')]" }

    widget = {
        name = "vvv_board"
        position = { 18 56 }
        size = { 1024 512 }
        icon = {
            name = "vvv_plains"
            size = { 1024 512 }
            texture = "gfx/interface/vvv/plains.dds"
            alwaystransparent = yes
        }
        widget = {
            name = "vvv_red_archers"
            position = { 120 0 }
            size = { 224 196 }
            tooltip = "vvv_archers_tt"
            using = tooltip_above
            icon = { size = { 224 196 } texture = "gfx/interface/vvv/red_archers.dds" alwaystransparent = yes }
            text_single = {
                position = { 72 58 }
                size = { 80 23 }
                autoresize = no
                align = center|nobaseline
                font = TitleFont
                fontsize = 21
                default_format = "#high"
                text = "[GetPlayer.MakeScope.Var('vvv_red_archers_count').GetValue|0]"
                alwaystransparent = yes
            }
        }
        widget = {
            name = "vvv_red_levies"
            position = { 400 0 }
            size = { 224 196 }
            tooltip = "vvv_levies_tt"
